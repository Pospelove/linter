{
  "modes": {
    "manual": {
      "fileSource": { "export": "AllFilesSource" }
    }
  },
  "checks": [
    {
      "name": "todo-check",
      "export": "RegexCheck",
      "modes": ["manual"],
      "options": {
        "pattern": "TODO.*",
        "message": "regex violation"
      },
      "prd": {
        "storySplitMode": "per-finding",
        "findingsPerStory": 5,
        "filesPerStory": 1
      }
    }
  ]
}
