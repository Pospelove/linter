{
  "modes": {
    "manual": {
      "fileSource": { "export": "AllFilesSource" }
    }
  },
  "checks": [
    {
      "name": "custom-findings",
      "export": "CustomCheck",
      "modes": ["manual"],
      "options": {
        "lintCommand": "bash lint.sh",
        "extensions": [".txt"]
      },
      "prd": {
        "storySplitMode": "per-finding"
      }
    },
    {
      "name": "custom-legacy",
      "export": "CustomCheck",
      "modes": ["manual"],
      "options": {
        "lintCommand": "echo 'Legacy failure'; exit 1",
        "extensions": [".txt"]
      }
    }
  ]
}
