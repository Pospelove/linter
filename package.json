{
  "name": "@skyrim-multiplayer/linter",
  "version": "0.0.1",
  "type": "module",
  "bin": {
    "skymp-linter": "dist/linter.mjs"
  },
  "scripts": {
    "!postinstall": "node -e \"if(process.cwd()!==process.env.INIT_CWD)process.exit(0)\" && mkdir -p .linter && curl -fsSL https://raw.githubusercontent.com/skyrim-multiplayer/linter/main/dist/linter.mjs -o .linter/linter.mjs",
    "build": "node esbuild.config.js",
    "lint": "node .linter/linter.mjs --lint",
    "fix": "node .linter/linter.mjs --fix",
    "update-linter": "cp dist/linter.mjs .linter/linter.mjs",
    "test": "yarn build && node tests/integration/run.mjs",
    "test:coverage": "node esbuild.config.js --sourcemap && c8 --reporter=text --reporter=html --exclude 'node_modules/**' --exclude 'tests/**' node tests/integration/run.mjs"
  },
  "dependencies": {
    "iconv-lite": "^0.7.2",
    "openai": "^6.34.0",
    "p-limit": "^7.3.0",
    "simple-git": "^3.27.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "c8": "^11.0.0",
    "esbuild": "^0.27.3",
    "typescript": "^6.0.2"
  }
}
